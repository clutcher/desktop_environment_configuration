#!/bin/bash

__claude_run_in_profile() {
    local profile_dir=$1
    shift

    (
        set -a
        [[ -f "$profile_dir/profile.env" ]] && { . "$profile_dir/profile.env" || exit 1; }
        set +a
        CLAUDE_CONFIG_DIR="$profile_dir" exec claude "$@"
    )
}

__claude_prepare_profile() {
    command -v claude-profile-prepare > /dev/null 2>&1 || return 0
    claude-profile-prepare --check --no-plugins "$1" || true
}

claude() {
    local profile_value="personal"
    local claude_args=()

    local color_border='\033[1;38;2;148;191;243m'
    local color_label='\033[1;37m'
    local color_value='\033[1;38;2;239;120;114m'
    local color_reset='\033[0m'

    show_help() {
        cat <<'EOF_HELP'
Usage: claude [-pf PROFILE] [--] [claude arguments...]

Options:
  -pf, --profile PROFILE  Select profile name ([a-z0-9-]+). Sets CLAUDE_CONFIG_DIR to
                          "$HOME/.claude-PROFILE" for the launched claude command and
                          loads "$HOME/.claude-PROFILE/profile.env" for that launch only.
  -h, --help              Show this help message and original claude help.
EOF_HELP
    }

    while [[ $# -gt 0 ]]; do
        case $1 in
            -pf|--profile)
                if [[ -z "$2" || "$2" == -* ]]; then
                    printf 'Error: %s requires a value\n' "$1" >&2
                    return 1
                fi
                if [[ ! "$2" =~ ^[a-z0-9-]+$ ]]; then
                    printf 'Error: invalid profile name "%s" (allowed: a-z, 0-9, -)\n' "$2" >&2
                    return 1
                fi
                profile_value="$2"
                shift 2
                ;;
            -h|--help)
                show_help
                printf '\nOriginal claude help:\n\n'
                __claude_run_in_profile "$HOME/.claude-$profile_value" --help
                return $?
                ;;
            --)
                shift
                claude_args+=("$@")
                break
                ;;
            *)
                claude_args+=("$1")
                shift
                ;;
        esac
    done

    __claude_prepare_profile "$profile_value"

    printf '\n'
    printf "${color_border}╔══════════════════════════════════════╗${color_reset}\n"
    printf "${color_border}║${color_label}          CLAUDE PROFILE              ${color_border}║${color_reset}\n"
    printf "${color_border}║${color_value} %-36s ${color_border}║${color_reset}\n" "$profile_value"
    printf "${color_border}╚══════════════════════════════════════╝${color_reset}\n"
    printf '\n'

    __claude_run_in_profile "$HOME/.claude-$profile_value" "${claude_args[@]}"
}
